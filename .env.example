# Server Configuration
PORT=3000

# Database Configuration
MONGO_CONNECT=mongodb://localhost:27017/ecommerce
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Secret Key (used for authentication tokens)
jwtSecretKey=your_jwt_secret_key_here

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (for OTP and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_SERVICE=Gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="You Name <your_email@gmail.com>"


# Session Secret (used for express-session)
SESSION_SECRET=your_session_secret_here

